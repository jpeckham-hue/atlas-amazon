# Normalize all text to LF in the repository and in working trees, on every OS.
# This overrides per-machine core.autocrlf settings.
* text=auto eol=lf

# Source and config (explicit, so detection never guesses wrong)
*.py      text eol=lf diff=python
*.toml    text eol=lf
*.md      text eol=lf diff=markdown
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.sh      text eol=lf

# Windows-only scripts need CRLF to run correctly
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.parquet binary
*.sqlite  binary
*.db      binary
